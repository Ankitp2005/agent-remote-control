# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.

# Shared secret the phone client must send on connect.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=replace_with_a_long_random_string

# Tailscale IP of this machine (run: tailscale ip -4 to find it).
# Never leave this blank or set to 0.0.0.0.
BIND_IP=100.x.x.x

# Port to listen on (default: 8787).
PORT=8787

# tmux session name to proxy (default: agent-1).
SESSION_NAME=agent-1

# ntfy.sh topic name for push notifications (optional).
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
NTFY_TOPIC=replace_with_a_long_random_string
